# ============================================================================
# LLM Model Configuration
# ============================================================================
# Use direct provider model strings (e.g., mistral/mistral-small-latest)
# or LiteLLM Proxy model strings (e.g., litellm_proxy/your_model_name)
LLM_SYNDATA_GEN=mistral/mistral-small-latest
LLM_PARAM_EXTRACTION=mistral/mistral-small-latest
LLM_PLANNER=mistral/mistral-small-latest
LLM_AGENT=mistral/mistral-small-latest
LLM_CONVERSATION_STORE=mistral/mistral-small-latest

# Client-side deadline, in seconds, for ONE LLM_CONVERSATION_STORE attempt
# (conversation topic/summary generation). Defaults to 12.
#
# This is a deadline on the request, not on whoever is awaiting it, and that is
# the point: the call runs in a worker thread, and a timeout on the await would
# cancel the wait while the thread kept running - which at process exit is
# joined for up to 300 s. Bounding the request is what lets the thread end by
# itself.
#
# The call gets at most two attempts (one retry), so the worst case is about
# twice this value. Keep the product inside the server's 30 s shutdown drain, or
# a rotate in flight when the process stops can outlive it. Do not set this at
# or below the normal latency of a topic+summary generation (a few seconds):
# every merely-slow /new_conversation then fails with HTTP 500.
# LLM_CONVERSATION_STORE_TIMEOUT_SECONDS=12

# ============================================================================
# LiteLLM Proxy Configuration (Optional)
# ============================================================================
# To route LLM calls through a LiteLLM Proxy, set the model strings above to
# use the litellm_proxy/ prefix and configure the proxy URL below.
# Example:
#   LLM_AGENT=litellm_proxy/bedrock_mistral_large_2407
#   LITELLM_PROXY_API_BASE=http://127.0.0.1:4000
# The proxy API key should be set in fastworkflow.passwords.env
# LITELLM_PROXY_API_BASE=http://127.0.0.1:4000

# ============================================================================
# Intent-detection base models (Optional)
# ============================================================================
# The intent-detection trainer uses two small HuggingFace models. These defaults
# are BERT/DistilBERT checkpoints that are natively compatible with transformers
# 4.48+ and 5.x (they ship a model_type and a loadable tokenizer).
# INTENT_DETECTION_TINY_MODEL=google/bert_uncased_L-4_H-128_A-2
# INTENT_DETECTION_LARGE_MODEL=distilbert-base-uncased

# ============================================================================
# Workflow Configuration
# ============================================================================
# Absolute root for all persistent state (conversations, suspended sessions,
# checkpoints, function caches). Defaults to ~/.local/state/fastworkflow.
# Each workflow's state is namespaced under <root>/workflows/<workflow-id>/,
# where <workflow-id> defaults to this workflow folder's name.
# FASTWORKFLOW_STATE_ROOT=~/.local/state/fastworkflow
# FASTWORKFLOW_WORKFLOW_ID=<override the default (folder name) if needed>

# Live sessions kept in the run_fastapi_mcp process cache. Defaults to 50.
# Deliberately left COMMENTED OUT: an active assignment here would be read from
# the workflow env file and would shadow the container's own MAX_LIVE_SESSIONS,
# which is the one an operator can actually reach in production. Uncomment only
# if you want this workflow to override the deployment.
# MAX_LIVE_SESSIONS=50
SYNTHETIC_UTTERANCE_GEN_NUMOF_PERSONAS=4
SYNTHETIC_UTTERANCE_GEN_UTTERANCES_PER_PERSONA=5
SYNTHETIC_UTTERANCE_GEN_PERSONAS_PER_BATCH=1
MISSING_INFORMATION_ERRMSG="Missing parameter values: "
INVALID_INFORMATION_ERRMSG="Invalid parameter values: "
NOT_FOUND="NOT_FOUND"
INVALID="INVALID"
PARAMETER_EXTRACTION_ERROR_MSG="Error in parameter extraction: {error}"

# ---------------------------------------------------------------------------
# Observability (fastWorkflow Chatbot / observability.sqlite3) — all optional.
# The SQLite trace sink is ON by default under fastworkflow's own entry points
# (run, run_fastapi_mcp, train, run_chatbot) and OFF for library embedders [R4].
# ---------------------------------------------------------------------------
# FW_OBSERVABILITY=1                  # master switch for the SQLite sink
# FW_OBS_DB_MAX_BYTES=1073741824      # soft size cap incl. the -wal sidecar
# FW_OBS_RETENTION_DAYS=30            # prune horizon for spans/artifacts
# FW_OBS_INLINE_ARTIFACT_BYTES=262144 # larger artifact values are offloaded
# FW_OBS_MAX_ATTR_BYTES=16384         # per-span-attribute cap (lossy+counted)
# FW_OBS_QUEUE_MAX=10000              # span/artifact writer queue bound
# FW_OBS_CAPTURE_TRACEBACKS=0         # persist traceback artifacts when 1
# FW_OBS_SYNC_WRITE_TIMEOUT_S=5       # busy timeout for in-request DB writes
