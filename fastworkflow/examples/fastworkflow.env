# ============================================================================
# LLM Model Configuration
# ============================================================================
# Use direct provider model strings (e.g., mistral/mistral-small-latest)
# or LiteLLM Proxy model strings (e.g., litellm_proxy/your_model_name)
LLM_SYNDATA_GEN=mistral/mistral-small-latest
LLM_PARAM_EXTRACTION=mistral/mistral-small-latest
LLM_PLANNER=mistral/mistral-small-latest
LLM_AGENT=mistral/mistral-small-latest
# Full-observation evidence search; independent of the main agent model.
LLM_OBSERVATION_SEARCH=mistral/mistral-small-latest
LLM_CONVERSATION_STORE=mistral/mistral-small-latest

# Client-side deadline, in seconds, for ONE LLM_CONVERSATION_STORE attempt
# (conversation topic/summary generation). Defaults to 12.
#
# This is a deadline on the request, not on whoever is awaiting it, and that is
# the point: the call runs in a worker thread, and a timeout on the await would
# cancel the wait while the thread kept running - which at process exit is
# joined for up to 300 s. Bounding the request is what lets the thread end by
# itself.
#
# The call gets at most two attempts (one retry), so the worst case is about
# twice this value. Keep the product inside the server's 30 s shutdown drain, or
# a rotate in flight when the process stops can outlive it. Do not set this at
# or below the normal latency of a topic+summary generation (a few seconds):
# every merely-slow /new_conversation then fails with HTTP 500.
# LLM_CONVERSATION_STORE_TIMEOUT_SECONDS=12

# ============================================================================
# LiteLLM Proxy Configuration (Optional)
# ============================================================================
# To route LLM calls through a LiteLLM Proxy, set the model strings above to
# use the litellm_proxy/ prefix and configure the proxy URL below.
# Example:
#   LLM_AGENT=litellm_proxy/bedrock_mistral_large_2407
#   LITELLM_PROXY_API_BASE=http://127.0.0.1:4000
# The proxy API key should be set in fastworkflow.passwords.env
# LITELLM_PROXY_API_BASE=http://127.0.0.1:4000

# ============================================================================
# Intent-detection base models (Optional)
# ============================================================================
# The intent-detection trainer uses two small HuggingFace models. These defaults
# are BERT/DistilBERT checkpoints that are natively compatible with transformers
# 4.48+ and 5.x (they ship a model_type and a loadable tokenizer).
# INTENT_DETECTION_TINY_MODEL=google/bert_uncased_L-4_H-128_A-2
# INTENT_DETECTION_LARGE_MODEL=distilbert-base-uncased

# ============================================================================
# Workflow Configuration
# ============================================================================
# Absolute root for all persistent state (conversations, suspended sessions,
# checkpoints, function caches). Defaults to ~/.local/state/fastworkflow.
# Each workflow's state is namespaced under <root>/workflows/<workflow-id>/,
# where <workflow-id> defaults to this workflow folder's name.
# FASTWORKFLOW_STATE_ROOT=~/.local/state/fastworkflow
# FASTWORKFLOW_WORKFLOW_ID=<override the default (folder name) if needed>

# Live sessions kept in the run_fastapi_mcp process cache. Defaults to 50.
# Deliberately left COMMENTED OUT: an active assignment here would be read from
# the workflow env file and would shadow the container's own MAX_LIVE_SESSIONS,
# which is the one an operator can actually reach in production. Uncomment only
# if you want this workflow to override the deployment.
# MAX_LIVE_SESSIONS=50
SYNTHETIC_UTTERANCE_GEN_NUMOF_PERSONAS=4
SYNTHETIC_UTTERANCE_GEN_UTTERANCES_PER_PERSONA=5
SYNTHETIC_UTTERANCE_GEN_PERSONAS_PER_BATCH=1
MISSING_INFORMATION_ERRMSG="Missing parameter values: "
INVALID_INFORMATION_ERRMSG="Invalid parameter values: "
NOT_FOUND="NOT_FOUND"
INVALID="INVALID"
PARAMETER_EXTRACTION_ERROR_MSG="Error in parameter extraction: {error}"

# ---------------------------------------------------------------------------
# Observability (fastWorkflow Chatbot / observability.sqlite3) — all optional.
# Recording is always on, under fastworkflow's own entry points and when the
# core is embedded as a library alike: the DB is owner-only (0600 in a 0700
# directory) under FASTWORKFLOW_STATE_ROOT and pruned by the settings below [R4].
# ---------------------------------------------------------------------------
# FW_OBS_DB_MAX_BYTES=1073741824      # soft size cap incl. the -wal sidecar
# FW_OBS_RETENTION_DAYS=30            # prune horizon for spans/artifacts
# FW_OBS_INLINE_ARTIFACT_BYTES=262144 # larger artifact values are offloaded
# FW_OBS_QUEUE_MAX=10000              # span/artifact writer queue bound
# FW_OBS_CAPTURE_TRACEBACKS=0         # persist traceback artifacts when 1
# FW_OBS_SYNC_WRITE_TIMEOUT_S=5       # busy timeout for in-request DB writes

# ---------------------------------------------------------------------------
# Context budgets (fastworkflow/context_budget.py) — all optional.
# ONE input: the model's context window in tokens. Unset, it is read from the
# LLM_AGENT model's own metadata via litellm, and 131,072 is the fallback.
# Every byte budget below is a fixed fraction of that window; the per-budget
# names are TUNING overrides, not the interface. See docs/context_budget.md.
# ---------------------------------------------------------------------------
# FW_MODEL_CONTEXT_TOKENS=131072       # the one input; overrides model metadata
# FW_TRAJECTORY_MAX_BYTES=28000        # packed-trajectory target
# FW_ANSWER_REHYDRATION_MAX_BYTES=250000  # answer-time extraction budget
# FW_SEARCH_ANSWER_MAX_BYTES=3072      # one search_memory answer observation
# FW_OFFLOAD_HOT_MAX_BYTES=262144      # hot cache of offloaded observations
# FW_OFFLOAD_MIN_SAVING_BYTES=1024     # minimum bytes an offload must free
# One observation read by search_memory. Cut from the SEARCH model's window
# (LLM_OBSERVATION_SEARCH; the smaller of FW_MODEL_CONTEXT_TOKENS and that
# model's metadata), a quarter of it capped at 131072. This override may
# exceed the cap; below 4096 it is refused and the derived value stands.
# FW_SEARCH_OBSERVATION_MAX_BYTES=131072

# ---------------------------------------------------------------------------
# Agent segment bound (fastworkflow/observation_offloading/continuation.py) —
# optional. Forced replans a turn may take when a segment hits its iteration
# limit (3, therefore 4 segments). Clamped to [0, 10]; a value that is not an
# integer is ignored. Each correction logs one warning.
# ---------------------------------------------------------------------------
# FW_MAX_FORCED_REPLANS=3

# ---------------------------------------------------------------------------
# Decision-model (TypeSafe Jev) features — optional, OFF by default. Each turns
# on only with its flag set to `jev` AND JEV_API_KEY set (passwords file) AND
# the SDK installed: pip install 'fastworkflow[jev]'. A set flag that cannot
# take effect (any other value, no SDK, no key) logs one warning per cause and
# the feature stays off; an unset flag is silent. Their tokens are not counted
# in fw.llm.call usage/cost totals. See docs/observation_search.md.
#
# DATA EGRESS WARNING: turning either on sends turn content to TypeSafe, a
# third-party service. Only CREDENTIAL patterns are scrubbed first (the
# credential scrub); names, identifiers and other personal data are sent as
# they are.
#   - search router: the search question, the agent's reasoning and the first
#     four lines of the searched observation.
#   - finish check: the user request, the turn's plan and a ledger of every
#     step (command, context, subject names, the head of each output).
# Both also stay off (one warning) under FW_OFFLOAD_EVIDENCE_REDACTION=off,
# because nothing would be scrubbed, and with a rejected FW_JEV_BASE_URL.
# The [jev] extra pins typesafe-sdk to exactly 0.7.2; a later release is not
# picked up until fastWorkflow is bumped to it.
# Vendor calls are hard-bounded: 2 s per routing call and at most 3 per turn,
# 4 s per finish-check call and 8 s per check, 10 s of vendor time per turn in
# all, at most 4 calls in flight per process. These are not settings.
# ---------------------------------------------------------------------------
# FW_SEARCH_ROUTER=jev                 # route all-rows searches to code
# FW_SEARCH_ROUTER_MODEL=jev-1.13.0    # router model (this is the default)
# FW_FINISH_CHECK=jev                  # check at finish that every plan step ran
# FW_FINISH_CHECK_MODEL=jev-1.13.0     # finish-check model (this is the default;
#                                      # another one warns: thresholds were
#                                      # calibrated on ido with the default)
# Either flag may instead name a decision provider registered from code
# (fastworkflow.observation_offloading.decision.register_decision_provider);
# then JEV_API_KEY, FW_JEV_BASE_URL and the *_MODEL settings are not read.
#
# Endpoint for both. https only, or plain http to a loopback address (a local
# stand-in); no credentials, query or fragment. A rejected value turns both
# features off with one warning. The SDK's own TYPESAFE_BASE_URL is IGNORED
# (one warning): it can no longer redirect the key and payloads.
# FW_JEV_BASE_URL=https://api.typesafe.ai
#
# Evaluation control: 0 turns off everything the finish check adds (no note,
# plain-text planner) while the checker stays attached and records
# reason "disabled". Read from this file first, then the process environment.
# Any other non-empty value fails the agent build; empty means unset.
# FW_EVAL_FINISH_REMINDERS=0
